server {
    server_name preview.nightforge.jp;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    root /var/www/explorer-lite;
    index index.html;
    
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    gzip on;
    gzip_types application/wasm text/plain text/css application/json application/javascript text/xml application/xml;

    # Transaction detail API
    location /api/preview/tx/ {
        proxy_pass http://localhost:3000/api/tx/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Transactions list API
    location /api/preview/transactions {
        proxy_pass http://localhost:3000/api/transactions;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # WebSocket proxy
    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    # General preview API
    location /api/preview/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Testnet API
    location /api/testnet/ {
        proxy_pass http://127.0.0.1:3004/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # CoinGecko price proxy
    location /api/price {
        proxy_pass http://127.0.0.1:3000/api/price;                                                    
        proxy_http_version 1.1;
        proxy_set_header Host $host;                                                      
    }

    # Static assets with long cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|wasm)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback
    location / {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }

    ssl_certificate /etc/letsencrypt/live/preview.nightforge.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/preview.nightforge.jp/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = preview.nightforge.jp) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name preview.nightforge.jp;
    return 404;
}
