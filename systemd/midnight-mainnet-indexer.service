[Unit]
Description=Midnight Mainnet Indexer - Port 3005
After=network.target

[Service]
Type=simple
User=midnight
WorkingDirectory=/home/midnight/mainnet-explorer
ExecStart=/home/midnight/.nvm/versions/node/v22.21.1/bin/npx tsx src/index.ts
Restart=always
RestartSec=10
Environment=PATH=/home/midnight/.nvm/versions/node/v22.21.1/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
