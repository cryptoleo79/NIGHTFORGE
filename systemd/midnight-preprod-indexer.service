[Unit]
Description=Midnight Preprod Indexer
After=network.target

[Service]
Type=simple
User=midnight
WorkingDirectory=/home/midnight/preprod-explorer
ExecStart=/home/midnight/.nvm/versions/node/v22.21.1/bin/npm run dev
Restart=always
RestartSec=10
Environment=PATH=/home/midnight/.nvm/versions/node/v22.21.1/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
